<!--
  local_rules.xml - ATTENSE custom correlation rules.

  These rules layer on top of Wazuh's stock ruleset (rules in /var/ossec/ruleset/rules).
  They match the JSON events emitted by the target-agent Flask app and elevate
  patterns of interest (brute force, cmd injection, directory traversal, XSS probe,
  webshell upload) into discrete alerts that the signal-store can map.

  The Flask app logs one JSON object per line, e.g.:
    {"timestamp":"...","level":"WARNING","logger":"target.auth",
     "message":{"event":"login_failure","endpoint":"/auth/login",
                "username":"admin","source_ip":"172.18.0.5"}}
  Wazuh's json decoder flattens those into fields like data.message.event.
-->
<group name="attense,target_app,">

  <!-- =========================================================== -->
  <!-- Base rule: any structured event from the target Flask app   -->
  <!-- =========================================================== -->
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="logger">^target\.</field>
    <description>ATTENSE target app event: $(message.event)</description>
  </rule>

  <!-- =========================================================== -->
  <!-- APP-06 : Broken authentication                              -->
  <!-- =========================================================== -->
  <rule id="100110" level="5">
    <if_sid>100100</if_sid>
    <field name="message.event">^login_failure$</field>
    <description>ATTENSE APP-06: failed login for user '$(message.username)' from $(message.source_ip)</description>
    <group>authentication_failed,attack,</group>
  </rule>

  <!-- Brute force: 6 failures from the same source_ip within 60s -->
  <rule id="100111" level="10" frequency="6" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>message.source_ip</same_field>
    <description>ATTENSE APP-06: brute-force login attempt from $(message.source_ip) (6+ failures in 60s)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,brute_force,attack,</group>
  </rule>

  <rule id="100112" level="8">
    <if_sid>100100</if_sid>
    <field name="message.event">^login_success$</field>
    <description>ATTENSE APP-06: successful login '$(message.username)' from $(message.source_ip)</description>
    <group>authentication_success,</group>
  </rule>

  <!-- A successful login preceded by brute-force attempts from the same IP = credential compromise.
       Wazuh requires frequency >= 2 when using if_matched_sid; since rule 100111 already fires
       once per 6 failed logins, requiring 2 matches = 12+ failures before this rule triggers. -->
  <rule id="100113" level="12" frequency="2" timeframe="120">
    <if_matched_sid>100111</if_matched_sid>
    <if_sid>100112</if_sid>
    <same_field>message.source_ip</same_field>
    <description>ATTENSE APP-06: credential COMPROMISE after brute-force from $(message.source_ip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_success,brute_force,attack,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- APP-02 : Command injection (ping endpoint)                  -->
  <!-- =========================================================== -->
  <rule id="100120" level="10">
    <if_sid>100100</if_sid>
    <field name="message.event">^ping_request$</field>
    <field name="message.host_param">[;&amp;|`$]</field>
    <description>ATTENSE APP-02: command-injection payload on /system/ping host='$(message.host_param)'</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>command_injection,attack,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- APP-01 : Reflected XSS                                      -->
  <!-- =========================================================== -->
  <rule id="100130" level="8">
    <if_sid>100100</if_sid>
    <field name="message.event">^search_request$</field>
    <field name="message.query" type="pcre2">(?i)(&lt;script|onerror=|javascript:|&lt;svg|onload=)</field>
    <description>ATTENSE APP-01: reflected XSS payload on /search q='$(message.query)'</description>
    <mitre>
      <id>T1059.007</id>
    </mitre>
    <group>xss,attack,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- APP-03 : Directory traversal                                -->
  <!-- =========================================================== -->
  <rule id="100140" level="10">
    <if_sid>100100</if_sid>
    <field name="message.event">^file_read_request$</field>
    <field name="message.path_param" type="pcre2">(\.\./|\.\.\\|%2e%2e|/etc/passwd|/etc/shadow|/proc/self)</field>
    <description>ATTENSE APP-03: directory-traversal attempt path='$(message.path_param)'</description>
    <mitre>
      <id>T1083</id>
    </mitre>
    <group>path_traversal,attack,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- APP-04 : Unrestricted file upload (webshell)                -->
  <!-- =========================================================== -->
  <rule id="100150" level="12">
    <if_sid>100100</if_sid>
    <field name="message.event" type="pcre2">^file_upload_(attempt|saved)$</field>
    <field name="message.filename" type="pcre2">\.(php|jsp|phtml|asp|aspx|sh|py)$</field>
    <description>ATTENSE APP-04: executable file upload '$(message.filename)'</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>web_shell,attack,</group>
  </rule>

  <!-- =========================================================== -->
  <!-- APP-05 : CSRF attempt (state-change without token/referer)  -->
  <!-- =========================================================== -->
  <rule id="100160" level="7">
    <if_sid>100100</if_sid>
    <field name="message.event">^profile_update$</field>
    <field name="message.referer">^none$</field>
    <description>ATTENSE APP-05: profile update without Referer (possible CSRF) from $(message.source_ip)</description>
    <mitre>
      <id>T1204</id>
    </mitre>
    <group>csrf,attack,</group>
  </rule>

</group>
