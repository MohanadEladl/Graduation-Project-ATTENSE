server {
    listen 80;
    server_name _;

    # Docker's embedded DNS, so proxy_pass re-resolves `thehive` at request
    # time (via a variable) instead of caching a single IP at nginx startup.
    # Without this, a recreated thehive container gets a new IP and every
    # proxied request 502s until this proxy is manually reloaded.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # TheHive is a same-origin transparent proxy target: this container
    # replaces thehive's own port publish, so from the browser it's still
    # exactly the same host:port it always was. TheHive's frontend (legacy
    # AngularJS) uses relative asset paths, so a 1:1 proxy needs no path
    # rewriting.
    #
    # sub_filter injects a single floating "Return to ATTENSE" button into
    # every HTML page TheHive serves - a real, always-visible, clickable
    # control inside TheHive's own UI (not a link buried in a description),
    # since TheHive has no extension/plugin mechanism to add one natively.
    # TheHive doesn't gzip its responses (verified live: no Content-Encoding
    # header even when the client advertises Accept-Encoding), so sub_filter
    # can rewrite the body without needing to strip compression first.
    #
    # The button's own href is a bare fallback (${ATTENSE_BLUE_URL}/, no
    # context) - landing there makes the ATTENSE frontend fall back to
    # whichever room happens to be first in the user's room list, which is
    # NOT necessarily the room/report they came from. The click handler below
    # looks up the case actually being viewed (TheHive's own API, using the
    # browser's already-authenticated session - no ATTENSE token available
    # here to pass along) and appends its attense:incident-<id> tag so the
    # user lands on THEIR OWN report instead of a random one.
    #
    # NOTE: nginx's sub_filter value is a single-quoted string, so nothing
    # inside this replacement may use a literal single quote (it would
    # terminate the directive early) - every JS string literal below is
    # double-quoted for that reason, not by JS style preference.
    sub_filter '</body>' '<a id="attense-return-btn" href="${ATTENSE_BLUE_URL}/" target="_blank" rel="noopener" style="position:fixed;bottom:20px;right:20px;z-index:999999;display:inline-flex;align-items:center;gap:8px;padding:12px 18px;border-radius:999px;background:#4a86e8;color:#fff;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;font-size:14px;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.25);">&#8592; Return to ATTENSE</a><script>(function(){var btn=document.getElementById("attense-return-btn");if(!btn)return;var base="${ATTENSE_BLUE_URL}";btn.addEventListener("click",function(ev){ev.preventDefault();var url=base+"/";var m=/#\/case\/([^\/?]+)/.exec(window.location.hash);var finish=function(){window.open(url,"_blank","noopener")};if(!m){finish();return}fetch("/api/case/"+m[1],{credentials:"include"}).then(function(r){return r.ok?r.json():null}).then(function(data){var tags=(data&&data.tags)||[];var tag=tags.find(function(t){return t.indexOf("attense:incident-")===0});if(tag){url=base+"/?view=reports&incidentId="+encodeURIComponent(tag.slice("attense:incident-".length))}}).catch(function(){}).then(finish)})})()</script></body>';
    sub_filter_once on;
    sub_filter_types text/html;

    location / {
        set                $thehive_upstream "thehive:9000";
        proxy_pass         http://$thehive_upstream;
        # nginx defaults the UPSTREAM connection to HTTP/1.0. TheHive's Play
        # backend refuses to send a chunked response (used by several of its
        # own API routes, e.g. the freetags-cache query the frontend calls on
        # every page load) to an HTTP/1.0 client - it throws
        # "HTTP 1.0 client does not support chunked response" and 500s. That
        # failed call stalled TheHive's own Angular bootstrap, leaving its
        # loading overlay stuck forever - which is why only the injected
        # button (way above it in z-index) was visible and the page looked
        # blank underneath. Forcing HTTP/1.1 upstream (the standard pairing
        # with clearing Connection) fixes this.
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;

        # TheHive serves index.html with `Cache-Control: public, max-age=3600`
        # and an ETag. That's fine for TheHive's own unmodified page, but this
        # proxy injects the return button into that SAME body - a browser that
        # cached the page (even from before this proxy existed, since the
        # upstream response is otherwise byte-identical) would keep serving
        # the stale, button-less copy for up to an hour without ever hitting
        # the network again. Force every response through this proxy to
        # always be revalidated so the injected button is never stale.
        proxy_hide_header  Cache-Control;
        proxy_hide_header  ETag;
        proxy_hide_header  Last-Modified;
        add_header         Cache-Control "no-store, no-cache, must-revalidate" always;
        expires            -1;
    }
}
